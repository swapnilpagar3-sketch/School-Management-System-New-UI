@{
    var username = Context.Request.Cookies["Username"];
    var profileImage = Context.Request.Cookies["ProfileImage"];
    var pageTitle = ViewData["Title"]?.ToString();

    // ---- current route (used to highlight the active menu item) ----
    var routeCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var routeAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsCtrl(string c) => string.Equals(routeCtrl, c, StringComparison.OrdinalIgnoreCase);
    bool IsAct(string c, string a) => IsCtrl(c) && string.Equals(routeAct, a, StringComparison.OrdinalIgnoreCase);

    var analyticsActions = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "TeacherPieChart", "SkillBarChart", "TeacherSalaryChart",
        "StudentsByGender", "MonthlyAdmissionsTrend",
        "PresentVsAbsent", "DailyAttendanceTrend", "DailyPresentVsAbsent", "TopStudentsByAttendance",
        "ExamWiseTotalMarksChart", "TotalMarksVsPassingMarksChart", "ExamsConductedMonthWiseChart",
        "ExamWisePassFailChart", "PassPercentagePerExamChart", "AverageMarksVsTotalMarksChart", "ExamWiseTopper",
        "DailyFeesCollectionChart", "PaymentModeDistribution", "PaymentModeCollectionChart"
    };

    bool IsMaster(string c) => IsCtrl(c) && !analyticsActions.Contains(routeAct);

    // ---- menu definitions ----
    var masters = new[]
    {
        ("Teacher", "Index", "Teachers", "bi-mortarboard-fill"),
        ("Students", "Index", "Students", "bi-person-fill"),
        ("Classes", "Index", "Classes", "bi-door-open-fill"),
        ("Subjects", "Index", "Subjects", "bi-book-fill"),
        ("Attendance", "Index", "Attendance", "bi-calendar-check-fill"),
        ("Examination", "Index", "Examination", "bi-journal-check"),
        ("Marks", "Index", "Exam Results", "bi-award-fill"),
        ("Fees", "Index", "Fees", "bi-cash-stack")
    };

    var analytics = new[]
    {
        ("teacher", "Teacher Analytics", "bi-mortarboard-fill", new[]
        {
            ("Teacher", "TeacherPieChart", "Teacher Reports"),
            ("Teacher", "SkillBarChart", "Teacher Skill Chart"),
            ("Teacher", "TeacherSalaryChart", "Teacher Salary Chart")
        }),
        ("student", "Student Analytics", "bi-person-fill", new[]
        {
            ("Students", "StudentsByGender", "Student Gender Reports"),
            ("Students", "MonthlyAdmissionsTrend", "Admission Trend")
        }),
        ("attendance", "Attendance Analytics", "bi-calendar-check-fill", new[]
        {
            ("Attendance", "PresentVsAbsent", "Attendance Summary"),
            ("Attendance", "DailyAttendanceTrend", "Daily Attendance Trend"),
            ("Attendance", "DailyPresentVsAbsent", "Daily Attendance Comparison"),
            ("Attendance", "TopStudentsByAttendance", "Attendance Leaders")
        }),
        ("exam", "Examination Analytics", "bi-journal-check", new[]
        {
            ("Examination", "ExamWiseTotalMarksChart", "Exam Marks Overview"),
            ("Examination", "TotalMarksVsPassingMarksChart", "Marks vs Passing Criteria"),
            ("Examination", "ExamsConductedMonthWiseChart", "Monthly Exam Schedule")
        }),
        ("result", "Exam Result Analytics", "bi-award-fill", new[]
        {
            ("Marks", "ExamWisePassFailChart", "Exam Wise Pass vs Fail"),
            ("Marks", "PassPercentagePerExamChart", "Pass Percentage Per Exam"),
            ("Marks", "AverageMarksVsTotalMarksChart", "Examwise Avg Marks"),
            ("Marks", "ExamWiseTopper", "Examwise Topper")
        }),
        ("fees", "Fees Analytics", "bi-cash-coin", new[]
        {
            ("Fees", "DailyFeesCollectionChart", "Daily Fees Collection"),
            ("Fees", "PaymentModeDistribution", "Payment Mode Analysis"),
            ("Fees", "PaymentModeCollectionChart", "Payment Mode Collection")
        })
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Management System</title>

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS (admin template theme) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EntityFrameworkCore.styles.css" asp-append-version="true" />

    <!-- Toastr -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <script>
        // restore the sidebar state before the page paints (desktop only)
        (function () {
            try {
                if (window.innerWidth >= 992 && localStorage.getItem('sms.sidebar.collapsed') === '1') {
                    document.body.classList.add('sidebar-collapsed');
                }
            } catch (e) { }
        })();
    </script>

    <div class="app-shell">

        <!-- ===================== Sidebar ===================== -->
        <aside class="app-sidebar" id="appSidebar">

            <a class="sb-brand" asp-controller="Home" asp-action="Index">
                <span class="sb-brand-logo">
                    <img src="~/images/school-logo.jpg" alt="School logo" />
                </span>
                <span class="sb-brand-text">
                    <span class="sb-brand-title">School System</span>
                    <small>Management Portal</small>
                </span>
            </a>

            <nav class="sb-scroll" aria-label="Main navigation">

                <div class="sb-label">Main</div>
                <ul class="sb-menu">
                    <li>
                        <a class="sb-link @(IsAct("Home", "Index") ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Index">
                            <i class="bi bi-house-door-fill sb-icon"></i>
                            <span>Home</span>
                        </a>
                    </li>
                    <li>
                        <a class="sb-link @(IsAct("Home", "Dashboard") ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Dashboard">
                            <i class="bi bi-speedometer2 sb-icon"></i>
                            <span>Analytics Dashboard</span>
                        </a>
                    </li>
                </ul>

                <div class="sb-label">Masters</div>
                <ul class="sb-menu">
                    @foreach (var m in masters)
                    {
                        <li>
                            <a class="sb-link @(IsMaster(m.Item1) ? "active" : "")"
                               asp-controller="@m.Item1"
                               asp-action="@m.Item2">
                                <i class="bi @m.Item4 sb-icon"></i>
                                <span>@m.Item3</span>
                            </a>
                        </li>
                    }
                </ul>

                <div class="sb-label">Analytics</div>
                <ul class="sb-menu">
                    @foreach (var g in analytics)
                    {
                        bool open = g.Item4.Any(i => IsAct(i.Item1, i.Item2));

                        <li>
                            <a class="sb-link sb-toggle @(open ? "" : "collapsed")"
                               href="#sb-grp-@g.Item1"
                               data-bs-toggle="collapse"
                               role="button"
                               aria-expanded="@(open ? "true" : "false")"
                               aria-controls="sb-grp-@g.Item1">
                                <i class="bi @g.Item3 sb-icon"></i>
                                <span>@g.Item2</span>
                                <i class="bi bi-chevron-down sb-chevron"></i>
                            </a>

                            <div class="collapse @(open ? "show" : "")" id="sb-grp-@g.Item1">
                                <ul class="sb-sub">
                                    @foreach (var it in g.Item4)
                                    {
                                        <li>
                                            <a class="sb-sublink @(IsAct(it.Item1, it.Item2) ? "active" : "")"
                                               asp-controller="@it.Item1"
                                               asp-action="@it.Item2">
                                                @it.Item3
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    }
                </ul>

            </nav>

            <div class="sb-footer">
                <i class="bi bi-mortarboard-fill me-1"></i>
                Orchids The International School
            </div>

        </aside>

        <div class="app-backdrop" id="sidebarBackdrop"></div>

        <!-- ===================== Main area ===================== -->
        <div class="app-main">

            <!-- Top bar -->
            <header class="app-topbar">

                <button type="button" class="icon-btn" id="sidebarToggle" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <form class="topbar-search" onsubmit="return false;">
                    <i class="bi bi-search"></i>
                    <input id="pageSearch"
                           class="form-control form-control-sm"
                           type="search"
                           placeholder="Search on current page..."
                           autocomplete="off" />
                </form>

                <div class="topbar-right">

                    <span class="topbar-chip d-none d-xl-inline-flex">
                        <i class="bi bi-calendar-event me-2"></i>
                        @DateTime.Now.ToString("dddd, dd MMM yyyy")
                    </span>

                    <!-- Notification -->
                    <a href="#" class="icon-btn position-relative" aria-label="Notifications">
                        <i class="bi bi-bell-fill"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger notif-badge">
                            3
                        </span>
                    </a>

                    <!-- Profile -->
                    <div class="dropdown">

                        <a class="profile-btn dropdown-toggle"
                           href="#"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            @if (!string.IsNullOrEmpty(profileImage))
                            {
                                <img src="@profileImage" class="avatar" alt="Profile" />
                            }
                            else
                            {
                                <i class="bi bi-person-circle fs-4"></i>
                            }

                            <span class="d-none d-sm-inline">@username</span>

                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li>
                                <div class="px-3 py-2">
                                    <small class="text-muted">
                                        Logged in as
                                    </small>
                                    <div class="fw-bold">
                                        @username
                                    </div>
                                </div>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="Login"
                                   asp-action="Logout">

                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Logout

                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </header>

            <!-- Content -->
            <div class="app-content">

                @if (!string.IsNullOrWhiteSpace(pageTitle))
                {
                    <nav aria-label="breadcrumb" class="page-crumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i>Home
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
                        </ol>
                    </nav>
                }

                <div class="container-fluid px-0">

                    <main role="main">

                        <div class="card main-card">
                            <div class="card-body">
                                @RenderBody()
                            </div>
                        </div>

                    </main>

                </div>

            </div>

            <!-- Footer -->
            <footer class="app-footer">

                <div class="row align-items-center g-3">

                    <!-- School Information -->
                    <div class="col-lg-5 col-md-6">

                        <div class="fw-semibold text-body mb-1">
                            <i class="bi bi-mortarboard-fill me-2 text-primary"></i>
                            Orchids The International School
                        </div>

                        <div class="footer-meta">
                            <span><i class="bi bi-geo-alt-fill text-danger me-1"></i>India</span>
                            <span><i class="bi bi-telephone-fill text-success me-1"></i>+91 1800-889-9999</span>
                            <span><i class="bi bi-envelope-fill text-info me-1"></i>info@orchidsinternationalschool.com</span>
                        </div>

                    </div>

                    <!-- Quick Links -->
                    <div class="col-lg-4 col-md-3">

                        <div class="footer-links">
                            <a asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill me-1"></i>Home
                            </a>
                            <a asp-controller="Home" asp-action="Dashboard">
                                <i class="bi bi-bar-chart-fill me-1"></i>Dashboard
                            </a>
                            <a asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock-fill me-1"></i>Privacy
                            </a>
                        </div>

                    </div>

                    <!-- Social Icons -->
                    <div class="col-lg-3 col-md-3 text-md-end footer-social">

                        <a href="https://www.facebook.com/ORCHIDSTheInternationalSchool/" target="_blank" rel="noopener" aria-label="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="https://www.instagram.com/orchids_international_schools/" target="_blank" rel="noopener" aria-label="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="https://x.com/Orchids_School" target="_blank" rel="noopener" aria-label="X">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                        <a href="https://in.linkedin.com/company/orchids-the-international-school" target="_blank" rel="noopener" aria-label="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>

                    </div>

                </div>

            </footer>

        </div>

    </div>

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Toastr -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: 4000,
            extendedTimeOut: 1000,
            preventDuplicates: true,
            newestOnTop: true
        };
    </script>

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success('@TempData["Success"]');
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            toastr.error('@TempData["Error"]');
        </script>
    }

    @if (TempData["Warning"] != null)
    {
        <script>
            toastr.warning('@TempData["Warning"]');
        </script>
    }

    @if (TempData["Info"] != null)
    {
        <script>
            toastr.info('@TempData["Info"]');
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Sidebar toggle -->
    <script>
        (function () {
            var body = document.body;
            var KEY = 'sms.sidebar.collapsed';

            function isMobile() { return window.matchMedia('(max-width: 991.98px)').matches; }

            document.getElementById('sidebarToggle').addEventListener('click', function () {
                if (isMobile()) {
                    body.classList.toggle('sidebar-open');
                } else {
                    body.classList.toggle('sidebar-collapsed');
                    try { localStorage.setItem(KEY, body.classList.contains('sidebar-collapsed') ? '1' : '0'); } catch (e) { }
                }
            });

            document.getElementById('sidebarBackdrop').addEventListener('click', function () {
                body.classList.remove('sidebar-open');
            });

            var active = document.querySelector('.app-sidebar .sb-link.active, .app-sidebar .sb-sublink.active');
            if (active && active.scrollIntoView) { active.scrollIntoView({ block: 'nearest' }); }
        })();
    </script>

    <!-- Search on current page -->
    <script>

        let matches = [];
        let currentIndex = -1;

        function removeHighlights()
        {
            matches = [];
            currentIndex = -1;

            document.querySelectorAll("mark.search-highlight, mark.search-current")
                .forEach(mark =>
                {
                    const text = document.createTextNode(mark.textContent);
                    mark.parentNode.replaceChild(text, mark);
                });

            document.body.normalize();
        }

        function highlightWord(word)
        {
            removeHighlights();

            if (!word)
                return;

            const regex = new RegExp(word, "gi");

            function walk(node)
            {
                if (node.nodeType === 3)
                {
                    const value = node.nodeValue;

                    if (regex.test(value))
                    {
                        const span = document.createElement("span");

                        span.innerHTML = value.replace(regex,
                            match => `<mark class="search-highlight">${match}</mark>`);

                        node.parentNode.replaceChild(span, node);
                    }
                }
                else if (
                    node.nodeType === 1 &&
                    node.childNodes &&
                    !["SCRIPT","STYLE","INPUT","TEXTAREA"].includes(node.tagName))
                {
                    [...node.childNodes].forEach(walk);
                }
            }

            walk(document.body);

            matches = [...document.querySelectorAll(".search-highlight")];

            if (matches.length > 0)
            {
                currentIndex = 0;
                focusCurrent();
            }
        }

        function focusCurrent()
        {
            matches.forEach(x =>
                x.classList.remove("search-current"));

            if (matches.length === 0)
                return;

            matches[currentIndex].classList.add("search-current");

            matches[currentIndex].scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        }

        document.getElementById("pageSearch")
        .addEventListener("keydown", function(e)
        {
            if (e.key !== "Enter")
                return;

            e.preventDefault();

            const word = this.value.trim();

            if (!word)
            {
                removeHighlights();
                return;
            }

            if (matches.length === 0)
            {
                highlightWord(word);
                return;
            }

            currentIndex++;

            if (currentIndex >= matches.length)
                currentIndex = 0;

            focusCurrent();
        });

        document.getElementById("pageSearch")
        .addEventListener("input", function()
        {
            removeHighlights();
        });

    </script>

</body>
</html>
