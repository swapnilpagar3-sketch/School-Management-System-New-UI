@model ForgotPasswordViewModel


@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">

    <div class="forgot-container">
        <img src="~/images/School-Logo.jpg" class="auth-logo" alt="School logo" />
        <h2 class="forgot-title">Forgot Password?</h2>

        <p class="forgot-subtitle">
            Enter your email address and we'll send you a link to reset your password.
        </p>

        <form asp-action="ForgotPassword" method="post">

            @* <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email"
                       name="Email"
                       class="form-control"
                       placeholder="Enter your email"
                       required />
            </div> *@

            <div class="mb-3">
                <label asp-for="EmailAddress"></label>

                <input asp-for="EmailAddress"
                       class="form-control" />

                <span asp-validation-for="EmailAddress"
                      class="text-danger"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-warning btn-reset">
                    Send Reset Link
                </button>
            </div>

        </form>

        <div class="back-login">
            <a asp-action="Login" asp-controller="Login">
                Back to Login
            </a>
        </div>
    </div>

</body>
</html>